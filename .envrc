# direnv configuration - automatically load mise tools
# Install direnv: https://direnv.net/

# Use mise for tool management
use mise

# Load local environment variables if they exist
dotenv_if_exists .env.local

# Add zig-out/bin to PATH for built binaries
PATH_add zig-out/bin

# Set up development environment
export ZIG_ENV="development"

# Enable zig build cache
export ZIG_LOCAL_CACHE_DIR=".zig-cache"

# Enable colored output
export FORCE_COLOR=1
